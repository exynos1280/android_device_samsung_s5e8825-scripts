From ca6817f65655410de46d3ec1b35e7189c5cee362 Mon Sep 17 00:00:00 2001
From: Flopster101 <nahuelgomez329@gmail.com>
Date: Sun, 31 Aug 2025 03:51:41 -0300
Subject: [PATCH] telephony: Fix various Samsung SMSC formatting issues

Samsung's RIL implementation provides the SMS Service Center (SMSC)
address in several non-standard formats, causing SMS sending to fail,
especially with carriers that require a valid SMSC.

This patch provides a fix by checking for and correcting
three distinct formatting issues in the order they appear:

1.  Parses the quoted format (e.g., "0791...55",0) to extract the
    raw SMSC string.

2.  Checks if the extracted string is in PDU format. If so, it decodes
    this PDU into the correct international phone number format
    (e.g., +541151740055).

3.  If the string is not a PDU, it tries to check if it's a plain phone
    number missing the required '+' prefix. If so, it prepends it.

This ensures that the framework receives a correctly formatted
SMSC number and should make it work for a wider range of carriers.

Tested and working on:
- Carriers: Personal AR, Claro AR.
- Device: Galaxy A25 (A256E) with A546BXXSDDYF1 RIL stack.

* This commit is based on the following TrebleDroid patches, just with enhanced parsing:
https://github.com/TrebleDroid/platform_frameworks_opt_telephony/commit/0fdaaba9c88cbc3d8c9c5288d6d2820fd6bd344e
https://github.com/TrebleDroid/platform_frameworks_opt_telephony/commit/9de26ca6b0fcbbb8bc27ca75a57697a7724f797d

Signed-off-by: Flopster101 <nahuelgomez329@gmail.com>
Co-authored-by: Pierre-Hugues Husson <phh@phh.me>
---
 .../internal/telephony/MessagingResponse.java | 46 +++++++++++++++++++
 .../internal/telephony/RadioResponse.java     | 46 +++++++++++++++++++
 2 files changed, 92 insertions(+)

diff --git a/src/java/com/android/internal/telephony/MessagingResponse.java b/src/java/com/android/internal/telephony/MessagingResponse.java
index 19211e1..cc3f93e 100644
--- a/src/java/com/android/internal/telephony/MessagingResponse.java
+++ b/src/java/com/android/internal/telephony/MessagingResponse.java
@@ -170,9 +170,55 @@ public class MessagingResponse extends IRadioMessagingResponse.Stub {
      * @param smsc Short Message Service Center address on the device
      */
     public void getSmscAddressResponse(RadioResponseInfo responseInfo, String smsc) {
+        if (smsc != null && (smsc.contains("\"") || smsc.contains(","))) {
+            android.util.Log.e("SMSCFix", "Got weird SMSC: " + smsc);
+            try {
+                String[] a = smsc.split("\"");
+                smsc = a[1];
+            } catch (Throwable t) {
+                android.util.Log.e("SMSCFix", "Failed parsing weird smsc", t);
+                smsc = "";
+            }
+            android.util.Log.e("SMSCFix", "Patched smsc " + smsc);
+        }
+
+        // If SMSC is in PDU format
+        if (smsc != null && smsc.matches("^[0-9A-Fa-f]{12,}$") && smsc.startsWith("07")) {
+            String decoded = smscPduToPhoneNumber(smsc);
+            if (decoded != null && !decoded.isEmpty()) {
+                android.util.Log.e("SMSCFix", "Converted PDU SMSC to number: " + decoded);
+                smsc = decoded;
+            }
+        }
+        // If SMSC is a number without the '+' prefix
+        else if (smsc != null && smsc.matches("^[0-9]{10,}$") && !smsc.startsWith("+")) {
+            android.util.Log.e("SMSCFix", "SMSC looks like a number, prepending '+': " + smsc);
+            smsc = "+" + smsc;
+        }
         RadioResponse.responseString(HAL_SERVICE_MESSAGING, mRil, responseInfo, smsc);
     }
 
+    /* Minimal BCD decode for SMSC PDU */
+    private static String smscPduToPhoneNumber(String pdu) {
+        try {
+            if (pdu.length() < 4) return null;
+            int len = Integer.parseInt(pdu.substring(0, 2), 16);
+            if (pdu.length() < (2 + len * 2)) return null;
+            int toa = Integer.parseInt(pdu.substring(2, 4), 16);
+            StringBuilder num = new StringBuilder();
+            for (int i = 4; i < 2 + len * 2; i += 2) {
+                char c1 = pdu.charAt(i + 1);
+                char c2 = pdu.charAt(i);
+                if (c1 != 'F' && c1 != 'f') num.append(c1);
+                if (c2 != 'F' && c2 != 'f') num.append(c2);
+            }
+            if ((toa & 0xF0) == 0x90) num.insert(0, '+');
+            return num.toString();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
     /**
      * @param responseInfo Response info struct containing response type, serial no. and error
      */
diff --git a/src/java/com/android/internal/telephony/RadioResponse.java b/src/java/com/android/internal/telephony/RadioResponse.java
index 127d876..57dea1f 100644
--- a/src/java/com/android/internal/telephony/RadioResponse.java
+++ b/src/java/com/android/internal/telephony/RadioResponse.java
@@ -1237,9 +1237,55 @@ public class RadioResponse extends IRadioResponse.Stub {
      * @param smsc Short Message Service Center address on the device
      */
     public void getSmscAddressResponse(RadioResponseInfo responseInfo, String smsc) {
+        if (smsc != null && (smsc.contains("\"") || smsc.contains(","))) {
+            android.util.Log.e("SMSCFix", "Got weird SMSC: " + smsc);
+            try {
+                String[] a = smsc.split("\"");
+                smsc = a[1];
+            } catch (Throwable t) {
+                android.util.Log.e("SMSCFix", "Failed parsing weird smsc", t);
+                smsc = "";
+            }
+            android.util.Log.e("SMSCFix", "Patched smsc " + smsc);
+        }
+
+        // If SMSC is in PDU format
+        if (smsc != null && smsc.matches("^[0-9A-Fa-f]{12,}$") && smsc.startsWith("07")) {
+            String decoded = smscPduToPhoneNumber(smsc);
+            if (decoded != null && !decoded.isEmpty()) {
+                android.util.Log.e("SMSCFix", "Converted PDU SMSC to number: " + decoded);
+                smsc = decoded;
+            }
+        }
+        // If SMSC is a number without the '+' prefix
+        else if (smsc != null && smsc.matches("^[0-9]{10,}$") && !smsc.startsWith("+")) {
+            android.util.Log.e("SMSCFix", "SMSC looks like a number, prepending '+': " + smsc);
+            smsc = "+" + smsc;
+        }
         responseString(responseInfo, smsc);
     }
 
+    /* Minimal BCD decode for SMSC PDU */
+    private static String smscPduToPhoneNumber(String pdu) {
+        try {
+            if (pdu.length() < 4) return null;
+            int len = Integer.parseInt(pdu.substring(0, 2), 16);
+            if (pdu.length() < (2 + len * 2)) return null;
+            int toa = Integer.parseInt(pdu.substring(2, 4), 16);
+            StringBuilder num = new StringBuilder();
+            for (int i = 4; i < 2 + len * 2; i += 2) {
+                char c1 = pdu.charAt(i + 1);
+                char c2 = pdu.charAt(i);
+                if (c1 != 'F' && c1 != 'f') num.append(c1);
+                if (c2 != 'F' && c2 != 'f') num.append(c2);
+            }
+            if ((toa & 0xF0) == 0x90) num.insert(0, '+');
+            return num.toString();
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
     /**
      * @param responseInfo Response info struct containing response type, serial no. and error
      */
